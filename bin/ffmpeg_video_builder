#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"
require "optparse"
require "shellwords"
require "English"
require_relative "../lib/icon_search"
require_relative "../lib/kokoro_tts"
require_relative "../lib/openai_whisper"
require_relative "../lib/script_video_pipeline"

class FFmpegVideoBuilder
  DEFAULTS = {
    "output" => "video_output.mp4",
    "width" => 1080,
    "height" => 1920,
    "fps" => 30,
    "duration" => 10,
    "background" => { "type" => "color", "color" => "black" },
    "elements" => []
  }.freeze

  def self.call(config_path:, dry_run: false)
    config = JSON.parse(File.read(config_path))
    new(config, base_dir: File.dirname(File.expand_path(config_path)), dry_run: dry_run).build!
  end

  def initialize(config, base_dir:, dry_run: false)
    @config = deep_merge(DEFAULTS, config)
    @base_dir = base_dir
    @dry_run = dry_run
    @width = integer(@config.fetch("width"))
    @height = integer(@config.fetch("height"))
    @fps = integer(@config.fetch("fps"))
    @duration = number(@config.fetch("duration"))
    @input_args = []
    @filters = []
    @current_video_label = "base"
    @input_index = 0
  end

  def build!
    validate_ffmpeg! unless @dry_run
    add_background_input
    add_elements
    command = build_output_command

    puts Shellwords.join(command)
    return command if @dry_run

    system(*command) || raise("FFmpeg failed with status #{$CHILD_STATUS || 'unknown'}")
  end

  private

  def validate_ffmpeg!
    return if system("ffmpeg", "-version", out: File::NULL, err: File::NULL)

    raise "FFmpeg is not installed or not available in PATH. Install it first, then retry."
  end

  def add_background_input
    bg = @config.fetch("background")

    case bg.fetch("type", "color")
    when "color"
      color = bg.fetch("color", "black")
      @input_args += [
        "-f", "lavfi",
        "-i", "color=c=#{color}:s=#{@width}x#{@height}:d=#{@duration}:r=#{@fps}"
      ]
      @filters << "[0:v]format=yuv420p[base]"
      @input_index = 1
    when "image"
      file = resolve_file!(bg.fetch("file"))
      @input_args += ["-loop", "1", "-t", @duration.to_s, "-i", file]
      @filters << "[0:v]scale=#{@width}:#{@height}:force_original_aspect_ratio=increase,crop=#{@width}:#{@height},format=yuv420p[base]"
      @input_index = 1
    when "video"
      file = resolve_file!(bg.fetch("file"))
      @input_args += ["-stream_loop", "-1", "-i", file]
      @filters << "[0:v]scale=#{@width}:#{@height}:force_original_aspect_ratio=increase,crop=#{@width}:#{@height},trim=duration=#{@duration},setpts=PTS-STARTPTS,format=yuv420p[base]"
      @input_index = 1
    else
      raise ArgumentError, "Unsupported background type: #{bg['type']}"
    end
  end

  def add_elements
    @config.fetch("elements", []).each_with_index do |element, index|
      case element.fetch("type")
      when "image", "icon"
        add_image_element(element, index)
      when "text"
        add_text_element(element, index)
      when "rectangle"
        add_rectangle_element(element, index)
      else
        warn "Skipping unsupported element type: #{element['type']}"
      end
    end
  end

  def add_image_element(element, index)
    file = prepare_image_file(resolve_file!(element.fetch("file")))
    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    width = integer(element.fetch("width", 300))
    opacity = number(element.fetch("opacity", 1.0))
    animation = element.fetch("animation", "fade")

    input_label = "img#{index}"
    output_label = "v#{index}"

    @input_args += ["-loop", "1", "-t", @duration.to_s, "-i", file]

    filter = "[#{@input_index}:v]scale=#{width}:-1,format=rgba"
    filter += ",colorchannelmixer=aa=#{opacity}" if opacity < 1.0
    filter += image_fade_filter(animation, start_time, end_time)
    filter += "[#{input_label}]"
    @filters << filter

    x = overlay_x(element.fetch("x", "center"), animation, start_time)
    y = overlay_y(element.fetch("y", "center"), animation, start_time)

    @filters << "[#{@current_video_label}][#{input_label}]overlay=x='#{x}':y='#{y}':enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @current_video_label = output_label
    @input_index += 1
  end

  def add_text_element(element, index)
    unless ffmpeg_filter_available?("drawtext")
      warn_missing_drawtext
      return
    end

    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    text = escape_drawtext(element.fetch("text"))
    font_size = integer(element.fetch("font_size", 54))
    color = element.fetch("color", "white")
    output_label = "vtext#{index}"
    x = drawtext_x(element.fetch("x", "center"))
    y = drawtext_y(element.fetch("y", @height - 260))
    font_file = element["font_file"] || @config["font_file"]

    drawtext = "[#{@current_video_label}]drawtext="
    drawtext += "fontfile='#{escape_filter_path(resolve_optional_file(font_file))}':" if font_file && !font_file.empty?
    drawtext += "text='#{text}':fontsize=#{font_size}:fontcolor=#{color}:x=#{x}:y=#{y}:"

    if element.fetch("box", false)
      box_color = element.fetch("box_color", "black@0.45")
      border = integer(element.fetch("box_border", 28))
      drawtext += "box=1:boxcolor=#{box_color}:boxborderw=#{border}:"
    end

    drawtext += "enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @filters << drawtext
    @current_video_label = output_label
  end

  def add_rectangle_element(element, index)
    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    x = element.fetch("x", 0)
    y = element.fetch("y", 0)
    width = element.fetch("width", @width)
    height = element.fetch("height", 200)
    color = element.fetch("color", "black@0.35")
    output_label = "vrect#{index}"

    @filters << "[#{@current_video_label}]drawbox=x=#{x}:y=#{y}:w=#{width}:h=#{height}:color=#{color}:t=fill:enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @current_video_label = output_label
  end

  def build_output_command
    audio_file = resolve_optional_file(@config["audio"])
    output = resolve_output(@config.fetch("output"))

    if audio_file && !audio_file.empty?
      @input_args += ["-i", audio_file]
      audio_index = @input_index
      @input_index += 1

      [
        "ffmpeg", "-y",
        *@input_args,
        "-filter_complex", @filters.join(";"),
        "-map", "[#{@current_video_label}]",
        "-map", "#{audio_index}:a",
        "-t", @duration.to_s,
        "-r", @fps.to_s,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-c:a", "aac",
        "-b:a", "192k",
        "-shortest",
        output
      ]
    else
      [
        "ffmpeg", "-y",
        *@input_args,
        "-filter_complex", @filters.join(";"),
        "-map", "[#{@current_video_label}]",
        "-t", @duration.to_s,
        "-r", @fps.to_s,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        output
      ]
    end
  end

  def image_fade_filter(animation, start_time, end_time)
    case animation
    when "none"
      ""
    when "fade", "slide_left", "slide_right", "slide_up", "slide_down", "pop"
      fade_out_start = [end_time - 0.25, start_time].max
      ",fade=t=in:st=#{start_time}:d=0.25:alpha=1,fade=t=out:st=#{fade_out_start}:d=0.25:alpha=1"
    else
      warn "Unknown animation '#{animation}', using fade"
      fade_out_start = [end_time - 0.25, start_time].max
      ",fade=t=in:st=#{start_time}:d=0.25:alpha=1,fade=t=out:st=#{fade_out_start}:d=0.25:alpha=1"
    end
  end

  def overlay_x(value, animation, start_time)
    target = position_x(value)
    transition = 0.45

    case animation
    when "slide_left"
      "if(lt(t,#{start_time + transition}), W-((t-#{start_time})/#{transition})*(W-(#{target})), #{target})"
    when "slide_right"
      "if(lt(t,#{start_time + transition}), -w+((t-#{start_time})/#{transition})*(#{target}+w), #{target})"
    else
      target
    end
  end

  def overlay_y(value, animation, start_time)
    target = position_y(value)
    transition = 0.45

    case animation
    when "slide_up"
      "if(lt(t,#{start_time + transition}), H-((t-#{start_time})/#{transition})*(H-(#{target})), #{target})"
    when "slide_down"
      "if(lt(t,#{start_time + transition}), -h+((t-#{start_time})/#{transition})*(#{target}+h), #{target})"
    else
      target
    end
  end

  def position_x(value)
    case value
    when "center" then "(W-w)/2"
    when "left" then "80"
    when "right" then "W-w-80"
    else value.to_s
    end
  end

  def position_y(value)
    case value
    when "center" then "(H-h)/2"
    when "top" then "120"
    when "bottom" then "H-h-160"
    else value.to_s
    end
  end

  def drawtext_x(value)
    case value
    when "center" then "(w-text_w)/2"
    when "left" then "80"
    when "right" then "w-text_w-80"
    else value.to_s
    end
  end

  def drawtext_y(value)
    case value
    when "center" then "(h-text_h)/2"
    when "top" then "140"
    when "bottom" then "h-text_h-180"
    else value.to_s
    end
  end

  def resolve_file!(path)
    full_path = absolute_path(path)
    raise "File not found: #{full_path}" unless File.exist?(full_path)

    full_path
  end

  def prepare_image_file(file)
    return file unless File.extname(file).downcase == ".svg"
    return file if ffmpeg_decoder_available?("svg")

    rasterize_svg!(file)
  end

  def rasterize_svg!(file)
    target = file.sub(/\.svg\z/i, ".png")
    return target if File.file?(target)

    qlmanage = "/usr/bin/qlmanage"
    unless File.executable?(qlmanage)
      raise "FFmpeg cannot decode SVG image input: #{file}. Install an FFmpeg build with SVG support or use PNG image assets."
    end

    output_dir = File.dirname(file)
    generated = File.join(output_dir, "#{File.basename(file)}.png")
    command = [qlmanage, "-t", "-s", "512", "-o", output_dir, file]
    ok = system(*command, out: File::NULL, err: File::NULL)

    unless ok && File.file?(generated)
      raise "Could not rasterize SVG image input for FFmpeg: #{file}"
    end

    FileUtils.mv(generated, target)
    target
  end

  def ffmpeg_filter_available?(name)
    return true if @dry_run

    available_ffmpeg_filters.include?(name)
  end

  def ffmpeg_decoder_available?(name)
    return true if @dry_run

    available_ffmpeg_decoders.include?(name)
  end

  def available_ffmpeg_filters
    @available_ffmpeg_filters ||= ffmpeg_list("filters")
  end

  def available_ffmpeg_decoders
    @available_ffmpeg_decoders ||= ffmpeg_list("decoders")
  end

  def ffmpeg_list(kind)
    stdout, stderr, status = Open3.capture3("ffmpeg", "-hide_banner", "-#{kind}")
    raise "Could not inspect FFmpeg #{kind}: #{stderr.empty? ? stdout : stderr}" unless status.success?

    stdout.lines.map { |line| line.split[1] }.compact
  end

  def warn_missing_drawtext
    return if @warned_missing_drawtext

    warn "FFmpeg drawtext filter is unavailable; skipping burned-in text overlays. Subtitle timing files are still written."
    @warned_missing_drawtext = true
  end

  def resolve_optional_file(path)
    return nil if path.nil? || path.to_s.empty?

    absolute_path(path)
  end

  def resolve_output(path)
    absolute_path(path)
  end

  def absolute_path(path)
    path = path.to_s
    File.absolute_path(path.start_with?("/") ? path : File.join(@base_dir, path))
  end

  def escape_drawtext(text)
    text.to_s
        .gsub("\\", "\\\\")
        .gsub(":", "\\:")
        .gsub("'", "\\\\'")
        .gsub("%", "\\%")
        .gsub("\n", "\\n")
  end

  def escape_filter_path(path)
    path.to_s.gsub("\\", "\\\\").gsub(":", "\\:").gsub("'", "\\\\'")
  end

  def integer(value)
    Integer(value)
  rescue ArgumentError, TypeError
    raise ArgumentError, "Expected integer, got #{value.inspect}"
  end

  def number(value)
    Float(value)
  rescue ArgumentError, TypeError
    raise ArgumentError, "Expected number, got #{value.inspect}"
  end

  def deep_merge(base, override)
    base.merge(override) do |_key, old_value, new_value|
      old_value.is_a?(Hash) && new_value.is_a?(Hash) ? deep_merge(old_value, new_value) : new_value
    end
  end
end

options = {
  dry_run: false,
  icon_style: IconSearch::DEFAULT_STYLE,
  icon_source: IconSearch::DEFAULT_SOURCE,
  icon_license_type: IconSearch::DEFAULT_LICENSE_TYPE,
  icon_size: IconSearch::DEFAULT_SIZE,
  icon_limit: IconSearch::DEFAULT_LIMIT,
  kokoro_voice: KokoroTTS::DEFAULT_VOICE,
  kokoro_speed: KokoroTTS::DEFAULT_SPEED,
  kokoro_lang_code: KokoroTTS::DEFAULT_LANG_CODE,
  whisper_model: OpenAIWhisper::DEFAULT_MODEL,
  whisper_output_format: OpenAIWhisper::DEFAULT_OUTPUT_FORMAT,
  whisper_task: OpenAIWhisper::DEFAULT_TASK,
  whisper_word_timestamps: OpenAIWhisper::DEFAULT_WORD_TIMESTAMPS
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ffmpeg_video_builder [options] path/to/script.txt|path/to/project.json"
  opts.on("--dry-run", "Print the FFmpeg command without executing it") do
    options[:dry_run] = true
  end
  opts.on("--icon-search KEYWORD", "Search Iconify icons by keyword and print JSON results") do |keyword|
    options[:icon_search_keyword] = keyword
  end
  opts.on("--icon-style STYLE", "Icon style preference, default: #{IconSearch::DEFAULT_STYLE}") do |style|
    options[:icon_style] = style
  end
  opts.on("--icon-source SOURCE", "Iconify source prefix, default: #{IconSearch::DEFAULT_SOURCE}") do |source|
    options[:icon_source] = source
  end
  opts.on("--icon-license-type TYPE", "Icon license type, default: #{IconSearch::DEFAULT_LICENSE_TYPE}") do |license_type|
    options[:icon_license_type] = license_type
  end
  opts.on("--icon-size PIXELS", Integer, "Icon asset size in pixels, default: #{IconSearch::DEFAULT_SIZE}") do |size|
    options[:icon_size] = size
  end
  opts.on("--icon-limit COUNT", Integer, "Maximum icon search results, default: #{IconSearch::DEFAULT_LIMIT}") do |limit|
    options[:icon_limit] = limit
  end
  opts.on("--kokoro-speak TEXT", "Generate narration audio with local Kokoro text") do |text|
    options[:kokoro_text] = text
  end
  opts.on("--kokoro-script FILE", "Generate narration audio with local Kokoro from a text file") do |file|
    options[:kokoro_text_file] = file
  end
  opts.on("--kokoro-voice VOICE", "Kokoro voice, default: #{KokoroTTS::DEFAULT_VOICE}") do |voice|
    options[:kokoro_voice] = voice
  end
  opts.on("--kokoro-speed SPEED", Float, "Kokoro speed, default: #{KokoroTTS::DEFAULT_SPEED}") do |speed|
    options[:kokoro_speed] = speed
  end
  opts.on("--kokoro-lang-code CODE", "Kokoro language code, default: #{KokoroTTS::DEFAULT_LANG_CODE}") do |lang_code|
    options[:kokoro_lang_code] = lang_code
  end
  opts.on("--whisper-transcribe AUDIO_FILE", "Transcribe an audio file with OpenAI Whisper") do |file|
    options[:whisper_audio_file] = file
  end
  opts.on("--whisper-model MODEL", "Local Whisper model, default: #{OpenAIWhisper::DEFAULT_MODEL}") do |model|
    options[:whisper_model] = model
  end
  opts.on("--whisper-output-format FORMAT", "Whisper output format, default: #{OpenAIWhisper::DEFAULT_OUTPUT_FORMAT}") do |format|
    options[:whisper_output_format] = format
  end
  opts.on("--whisper-task TASK", "Whisper task, default: #{OpenAIWhisper::DEFAULT_TASK}") do |task|
    options[:whisper_task] = task
  end
  opts.on("--[no-]whisper-word-timestamps", "Enable word timestamps for sentence timing, default: enabled") do |word_timestamps|
    options[:whisper_word_timestamps] = word_timestamps
  end
  opts.on("--whisper-language LANGUAGE", "Optional input language hint, such as en or id") do |language|
    options[:whisper_language] = language
  end
  opts.on("--whisper-prompt PROMPT", "Optional prompt to guide transcription style or vocabulary") do |prompt|
    options[:whisper_prompt] = prompt
  end
  opts.on("-h", "--help", "Show help") do
    puts opts
    exit 0
  end
end

parser.parse!

begin
  if options[:icon_search_keyword]
    batch = IconSearch.search_and_download(
      keyword: options.fetch(:icon_search_keyword),
      style: options.fetch(:icon_style),
      source: options.fetch(:icon_source),
      license_type: options.fetch(:icon_license_type),
      size: options.fetch(:icon_size),
      limit: options.fetch(:icon_limit)
    )
    puts JSON.pretty_generate(batch.to_h)
    exit 0
  end

  if options[:kokoro_text] || options[:kokoro_text_file]
    narration = KokoroTTS.speak(
      text: options[:kokoro_text],
      text_file: options[:kokoro_text_file],
      voice: options.fetch(:kokoro_voice),
      speed: options.fetch(:kokoro_speed),
      lang_code: options.fetch(:kokoro_lang_code)
    )
    puts JSON.pretty_generate(narration.to_h)
    exit 0
  end

  if options[:whisper_audio_file]
    transcription = OpenAIWhisper.transcribe(
      file: options.fetch(:whisper_audio_file),
      model: options.fetch(:whisper_model),
      output_format: options.fetch(:whisper_output_format),
      task: options.fetch(:whisper_task),
      word_timestamps: options.fetch(:whisper_word_timestamps),
      language: options[:whisper_language],
      prompt: options[:whisper_prompt]
    )
    puts JSON.pretty_generate(transcription.to_h)
    exit 0
  end

  input_path = ARGV.first

  unless input_path
    warn parser
    exit 1
  end

  if File.extname(input_path).downcase == ".json"
    FFmpegVideoBuilder.call(config_path: input_path, dry_run: options[:dry_run])
  else
    pipeline = ScriptVideoPipeline.prepare(
      script_file: input_path,
      options: {
        icon_style: options.fetch(:icon_style),
        icon_source: options.fetch(:icon_source),
        icon_license_type: options.fetch(:icon_license_type),
        icon_size: options.fetch(:icon_size),
        kokoro_voice: options.fetch(:kokoro_voice),
        kokoro_speed: options.fetch(:kokoro_speed),
        kokoro_lang_code: options.fetch(:kokoro_lang_code),
        whisper_model: options.fetch(:whisper_model),
        whisper_task: options.fetch(:whisper_task),
        whisper_word_timestamps: options.fetch(:whisper_word_timestamps),
        whisper_language: options[:whisper_language],
        whisper_prompt: options[:whisper_prompt]
      }
    )
    puts JSON.pretty_generate(pipeline.to_h)
    FFmpegVideoBuilder.call(config_path: pipeline.config_file, dry_run: options[:dry_run])
  end
rescue StandardError => e
  warn "Error: #{e.message}"
  exit 1
end
