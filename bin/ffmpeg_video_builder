#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"
require "optparse"
require "shellwords"
require "English"
require "uri"
require_relative "../lib/icon_search"
require_relative "../lib/kokoro_tts"
require_relative "../lib/openai_whisper"
require_relative "../lib/script_video_pipeline"

def load_local_environment!
  config_file = File.expand_path("../config/local.env", __dir__)
  return unless File.file?(config_file)

  File.readlines(config_file, chomp: true).each do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?("#")

    key, value = stripped.split("=", 2)
    next if key.nil? || value.nil?

    key = key.strip
    value = value.strip
    value = value[1..-2] if (value.start_with?('"') && value.end_with?('"')) ||
                             (value.start_with?("'") && value.end_with?("'"))

    if key == "PATH_PREPEND"
      ENV["PATH"] = [value, ENV.fetch("PATH", "")].reject(&:empty?).join(File::PATH_SEPARATOR)
    else
      ENV[key] = value
    end
  end
end

load_local_environment!

class FFmpegVideoBuilder
  DEFAULTS = {
    "output" => "video_output.mp4",
    "width" => 1080,
    "height" => 1920,
    "fps" => 30,
    "duration" => 10,
    "background" => { "type" => "color", "color" => "#FFC067" },
    "elements" => []
  }.freeze

  def self.call(config_path:, dry_run: false)
    config = JSON.parse(File.read(config_path))
    new(config, base_dir: File.dirname(File.expand_path(config_path)), dry_run: dry_run).build!
  end

  def initialize(config, base_dir:, dry_run: false)
    @config = deep_merge(DEFAULTS, config)
    @base_dir = base_dir
    @dry_run = dry_run
    @width = integer(@config.fetch("width"))
    @height = integer(@config.fetch("height"))
    @fps = integer(@config.fetch("fps"))
    @duration = number(@config.fetch("duration"))
    @input_args = []
    @filters = []
    @current_video_label = "base"
    @input_index = 0
  end

  def build!
    validate_ffmpeg! unless @dry_run
    add_background_input
    add_elements
    command = build_output_command

    puts Shellwords.join(command)
    return command if @dry_run

    system(*command) || raise("FFmpeg failed with status #{$CHILD_STATUS || 'unknown'}")
  end

  private

  def validate_ffmpeg!
    return if system("ffmpeg", "-version", out: File::NULL, err: File::NULL)

    raise "FFmpeg is not installed or not available in PATH. Install it first, then retry."
  end

  def add_background_input
    bg = @config.fetch("background")

    case bg.fetch("type", "color")
    when "color"
      color = bg.fetch("color", "#FFC067")
      @input_args += [
        "-f", "lavfi",
        "-i", "color=c=#{color}:s=#{@width}x#{@height}:d=#{@duration}:r=#{@fps}"
      ]
      @filters << "[0:v]format=yuv420p[base]"
      @input_index = 1
    when "image"
      file = resolve_background_media!(bg)
      @input_args += ["-loop", "1", "-t", @duration.to_s, "-i", file]
      @filters << "[0:v]scale=#{@width}:#{@height}:force_original_aspect_ratio=increase,crop=#{@width}:#{@height},setsar=1,format=yuv420p[base]"
      @input_index = 1
    when "video"
      file = resolve_background_media!(bg)
      @input_args += ["-stream_loop", "-1", "-i", file]
      @filters << "[0:v]scale=#{@width}:#{@height}:force_original_aspect_ratio=increase,crop=#{@width}:#{@height},setsar=1,trim=duration=#{@duration},setpts=PTS-STARTPTS,format=yuv420p[base]"
      @input_index = 1
    else
      raise ArgumentError, "Unsupported background type: #{bg['type']}"
    end
  end

  def resolve_background_media!(background)
    source = background["url"] || background["path"] || background["file"]
    raise ArgumentError, "Background #{background.fetch('type')} requires url, path, or file" if source.nil? || source.to_s.empty?

    remote_url?(source) ? source.to_s : resolve_file!(source)
  end

  def remote_url?(value)
    uri = URI.parse(value.to_s)
    uri.is_a?(URI::HTTP) && !uri.host.to_s.empty?
  rescue URI::InvalidURIError
    false
  end

  def add_elements
    @config.fetch("elements", []).each_with_index do |element, index|
      case element.fetch("type")
      when "image", "icon"
        add_image_element(element, index)
      when "text"
        add_text_element(element, index)
      when "rectangle"
        add_rectangle_element(element, index)
      when "waveform"
        add_waveform_element(element, index)
      else
        warn "Skipping unsupported element type: #{element['type']}"
      end
    end
  end

  def add_image_element(element, index)
    image = prepare_image_file(
      resolve_file!(element.fetch("file")),
      rasterize_size: element["rasterize_size"]
    )
    file = image.fetch(:file)
    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    width = integer(element.fetch("width", 300))
    opacity = number(element.fetch("opacity", 1.0))
    animation = element.fetch("animation", "fade")
    persist = truthy?(element.fetch("persist", false))
    hold = truthy?(element.fetch("hold", persist))
    remove_background = truthy?(element.fetch("remove_background", image.fetch(:remove_background)))

    input_label = "img#{index}"
    output_label = "v#{index}"

    @input_args += ["-loop", "1", "-t", @duration.to_s, "-i", file]

    filter = "[#{@input_index}:v]format=rgba"
    filter += transparent_background_filter if remove_background
    filter += image_transform_filter(animation, width, start_time)
    filter += ",colorchannelmixer=aa=#{opacity}" if opacity < 1.0
    filter += image_fade_filter(animation, start_time, end_time, hold: hold)
    filter += "[#{input_label}]"
    @filters << filter

    x = overlay_x(element.fetch("x", "center"), animation, start_time)
    y = overlay_y(element.fetch("y", "center"), animation, start_time)

    overlay_end_time = persist ? @duration : end_time
    @filters << "[#{@current_video_label}][#{input_label}]overlay=x='#{x}':y='#{y}':enable='between(t,#{start_time},#{overlay_end_time})'[#{output_label}]"
    @current_video_label = output_label
    @input_index += 1
  end

  def add_text_element(element, index)
    unless ffmpeg_filter_available?("drawtext")
      warn_missing_drawtext
      add_text_image_element(element, index)
      return
    end

    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    text = escape_drawtext(element.fetch("text"))
    font_size = integer(element.fetch("font_size", 54))
    color = element.fetch("color", "white")
    output_label = "vtext#{index}"
    x = drawtext_x(element.fetch("x", "center"))
    y = drawtext_y(element.fetch("y", @height - 260))
    font_file = element["font_file"] || @config["font_file"]

    drawtext = "[#{@current_video_label}]drawtext="
    drawtext += "fontfile='#{escape_filter_path(resolve_optional_file(font_file))}':" if font_file && !font_file.empty?
    drawtext += "text='#{text}':fontsize=#{font_size}:fontcolor=#{color}:x=#{x}:y=#{y}:"

    if element.fetch("box", false)
      box_color = element.fetch("box_color", "black@0.45")
      border = integer(element.fetch("box_border", 28))
      drawtext += "box=1:boxcolor=#{box_color}:boxborderw=#{border}:"
    end

    drawtext += "enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @filters << drawtext
    @current_video_label = output_label
  end

  def add_text_image_element(element, index)
    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    text_file = write_text_svg(element, index)
    fallback = {
      "type" => "image",
      "file" => text_file,
      "start" => start_time,
      "end" => end_time,
      "width" => integer(element.fetch("fallback_width", 1000)),
      "x" => element.fetch("x", "center"),
      "y" => element.fetch("y", @height - 500),
      "animation" => "none",
      "remove_background" => true,
      "rasterize_size" => integer(element.fetch("fallback_rasterize_size", 640))
    }

    add_image_element(fallback, index)
  end

  def add_rectangle_element(element, index)
    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    x = element.fetch("x", 0)
    y = element.fetch("y", 0)
    width = element.fetch("width", @width)
    height = element.fetch("height", 200)
    color = element.fetch("color", "black@0.35")
    output_label = "vrect#{index}"

    @filters << "[#{@current_video_label}]drawbox=x=#{x}:y=#{y}:w=#{width}:h=#{height}:color=#{color}:t=fill:enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @current_video_label = output_label
  end

  def add_waveform_element(element, index)
    audio_file = resolve_optional_file(element["audio"] || @config["audio"])
    raise ArgumentError, "Waveform element requires an audio file" if audio_file.nil? || audio_file.empty?

    start_time = number(element.fetch("start", 0))
    end_time = number(element.fetch("end", @duration))
    waveform_width = integer(element.fetch("width", 320))
    waveform_height = integer(element.fetch("height", 64))
    mode = element.fetch("mode", "cline")
    scale = element.fetch("scale", "sqrt")
    color = element.fetch("color", "0x111111")
    opacity = number(element.fetch("opacity", 0.72))
    remove_background = truthy?(element.fetch("remove_background", true))
    input_label = "wave#{index}"
    output_label = "vwave#{index}"

    @input_args += ["-i", audio_file]
    audio_index = @input_index
    @input_index += 1

    filter = "[#{audio_index}:a]showwaves=s=#{waveform_width}x#{waveform_height}:mode=#{mode}:colors=#{color}:scale=#{scale}:r=#{@fps},format=rgba"
    filter += ",colorkey=black:0.01:0.0" if remove_background
    filter += ",colorchannelmixer=aa=#{opacity}" if opacity < 1.0
    filter += "[#{input_label}]"
    @filters << filter

    x = position_x(element.fetch("x", "center"))
    y = waveform_y(element, waveform_width, waveform_height)
    @filters << "[#{@current_video_label}][#{input_label}]overlay=x='#{x}':y='#{y}':enable='between(t,#{start_time},#{end_time})'[#{output_label}]"
    @current_video_label = output_label
  end

  def waveform_y(element, waveform_width, waveform_height)
    return position_y(element["y"]) if element.key?("y")

    position = element.fetch("position", "bottom").to_s
    anchor_y = number(element.fetch("anchor_y", 560))
    anchor_height = number(element.fetch("anchor_height", element.fetch("anchor_width", waveform_width)))
    gap = number(element.fetch("gap", 44))

    case position
    when "bottom", "below"
      (anchor_y + anchor_height + gap).round(3).to_s
    when "above", "top"
      (anchor_y - waveform_height - gap).round(3).to_s
    else
      raise ArgumentError, "Unsupported waveform position: #{position.inspect}. Use bottom or above."
    end
  end

  def build_output_command
    audio_file = resolve_optional_file(@config["audio"])
    output = resolve_output(@config.fetch("output"))

    if audio_file && !audio_file.empty?
      @input_args += ["-i", audio_file]
      audio_index = @input_index
      @input_index += 1

      [
        "ffmpeg", "-y",
        *@input_args,
        "-filter_complex", @filters.join(";"),
        "-map", "[#{@current_video_label}]",
        "-map", "#{audio_index}:a",
        "-t", @duration.to_s,
        "-r", @fps.to_s,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-c:a", "aac",
        "-b:a", "192k",
        "-shortest",
        output
      ]
    else
      [
        "ffmpeg", "-y",
        *@input_args,
        "-filter_complex", @filters.join(";"),
        "-map", "[#{@current_video_label}]",
        "-t", @duration.to_s,
        "-r", @fps.to_s,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        output
      ]
    end
  end

  def image_fade_filter(animation, start_time, end_time, hold: false)
    case animation
    when "none"
      ""
    when *supported_image_animations
      return ",fade=t=in:st=#{start_time}:d=0.25:alpha=1" if hold

      fade_out_start = [end_time - 0.25, start_time].max
      ",fade=t=in:st=#{start_time}:d=0.25:alpha=1,fade=t=out:st=#{fade_out_start}:d=0.25:alpha=1"
    else
      warn "Unknown animation '#{animation}', using fade"
      return ",fade=t=in:st=#{start_time}:d=0.25:alpha=1" if hold

      fade_out_start = [end_time - 0.25, start_time].max
      ",fade=t=in:st=#{start_time}:d=0.25:alpha=1,fade=t=out:st=#{fade_out_start}:d=0.25:alpha=1"
    end
  end

  def image_transform_filter(animation, width, start_time)
    transition = 0.45
    progress = "min(max((t-#{start_time})/#{transition},0),1)"
    base_scale = "scale=#{width}:-1:eval=frame,format=rgba"

    case animation
    when "pop"
      scale = "#{width}*(0.72+0.28*#{progress})"
      ",scale='#{scale}':-1:eval=frame,format=rgba"
    when "zoom_blur"
      scale = "#{width}*(1.24-0.24*#{progress})"
      ",scale='#{scale}':-1:eval=frame,format=rgba"
    when "bounce"
      scale = "#{width}*(1+0.16*sin(#{progress}*PI))"
      ",scale='#{scale}':-1:eval=frame,format=rgba"
    when "pulse_in"
      scale = "#{width}*(1+0.08*sin(#{progress}*2*PI))"
      ",scale='#{scale}':-1:eval=frame,format=rgba"
    when "rotate_in"
      angle = "(1-#{progress})*-0.18"
      ",#{base_scale},rotate='#{angle}':c=none:ow=rotw(iw):oh=roth(ih)"
    when "wipe_reveal"
      crop_width = "max(1,iw*#{progress})"
      ",#{base_scale},crop=w='#{crop_width}':h=ih:x=0:y=0"
    else
      ",#{base_scale}"
    end
  end

  def supported_image_animations
    %w[
      fade slide_left slide_right slide_up slide_down pop drop_in zoom_blur bounce
      rotate_in wipe_reveal pulse_in
    ]
  end

  def overlay_x(value, animation, start_time)
    target = position_x(value)
    transition = 0.45

    case animation
    when "slide_left"
      "if(lt(t,#{start_time + transition}), W-((t-#{start_time})/#{transition})*(W-(#{target})), #{target})"
    when "slide_right"
      "if(lt(t,#{start_time + transition}), -w+((t-#{start_time})/#{transition})*(#{target}+w), #{target})"
    else
      target
    end
  end

  def overlay_y(value, animation, start_time)
    target = position_y(value)
    transition = 0.45

    case animation
    when "slide_up"
      "if(lt(t,#{start_time + transition}), H-((t-#{start_time})/#{transition})*(H-(#{target})), #{target})"
    when "slide_down", "drop_in"
      "if(lt(t,#{start_time + transition}), -h+((t-#{start_time})/#{transition})*(#{target}+h), #{target})"
    else
      target
    end
  end

  def position_x(value)
    case value
    when "center" then "(W-w)/2"
    when "left" then "80"
    when "right" then "W-w-80"
    else value.to_s
    end
  end

  def position_y(value)
    case value
    when "center" then "(H-h)/2"
    when "top" then "120"
    when "bottom" then "H-h-160"
    else value.to_s
    end
  end

  def drawtext_x(value)
    case value
    when "center" then "(w-text_w)/2"
    when "left" then "80"
    when "right" then "w-text_w-80"
    else value.to_s
    end
  end

  def drawtext_y(value)
    case value
    when "center" then "(h-text_h)/2"
    when "top" then "140"
    when "bottom" then "h-text_h-180"
    else value.to_s
    end
  end

  def resolve_file!(path)
    full_path = absolute_path(path)
    raise "File not found: #{full_path}" unless File.exist?(full_path)

    full_path
  end

  def prepare_image_file(file, rasterize_size: nil)
    return { file: file, remove_background: false } unless File.extname(file).downcase == ".svg"
    return { file: file, remove_background: false } if ffmpeg_decoder_available?("svg")

    { file: rasterize_svg!(file, size: rasterize_size), remove_background: true }
  end

  def transparent_background_filter
    unless ffmpeg_filter_available?("colorkey")
      warn_missing_colorkey
      return ""
    end

    ",colorkey=white:0.08:0.0"
  end

  def rasterize_svg!(file, size: nil)
    target = file.sub(/\.svg\z/i, ".png")
    return target if File.file?(target)

    qlmanage = "/usr/bin/qlmanage"
    unless File.executable?(qlmanage)
      raise "FFmpeg cannot decode SVG image input: #{file}. Install an FFmpeg build with SVG support or use PNG image assets."
    end

    output_dir = File.dirname(file)
    generated = File.join(output_dir, "#{File.basename(file)}.png")
    command = [qlmanage, "-t", "-s", (size || 512).to_s, "-o", output_dir, file]
    ok = system(*command, out: File::NULL, err: File::NULL)

    unless ok && File.file?(generated)
      raise "Could not rasterize SVG image input for FFmpeg: #{file}"
    end

    FileUtils.mv(generated, target)
    target
  end

  def write_text_svg(element, index)
    dir = File.join(@base_dir, ".rendered_text")
    FileUtils.mkdir_p(dir)
    path = File.join(dir, "subtitle_#{format('%03d', index)}.svg")
    width = integer(element.fetch("fallback_canvas_width", 1080))
    font_size = integer(element.fetch("font_size", 54))
    line_height = (font_size * 1.2).round
    lines = element.fetch("text").to_s.split("\n")
    text_align = element.fetch("text_align", "left")
    height = [line_height * lines.length + 36, line_height + 36].max
    y = ((height - (line_height * lines.length)) / 2.0 + font_size).round
    color = svg_color(element.fetch("color", "black"))

    File.write(path, text_svg(width: width, height: height, lines: lines, y: y, line_height: line_height, font_size: font_size, color: color, text_align: text_align))
    FileUtils.rm_f(path.sub(/\.svg\z/i, ".png"))
    path
  end

  def text_svg(width:, height:, lines:, y:, line_height:, font_size:, color:, text_align:)
    text_lines = lines.each_with_index.map do |line, offset|
      text_x = svg_text_x(line, width, font_size, text_align)
      %(<text x="#{text_x}" y="#{y + (offset * line_height)}">#{escape_xml(line)}</text>)
    end.join("\n")

    <<~SVG
      <svg xmlns="http://www.w3.org/2000/svg" width="#{width}" height="#{height}" viewBox="0 0 #{width} #{height}">
        <rect width="100%" height="100%" fill="white"/>
        <g font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', Arial, sans-serif" font-size="#{font_size}" font-weight="700" fill="#{color}">
          #{text_lines}
        </g>
      </svg>
    SVG
  end

  def svg_text_x(line, width, font_size, text_align)
    return [font_size * 1.8, 72].max.round unless text_align.to_s == "center"

    estimated_width = line.to_s.length * font_size * 0.58
    [((width - estimated_width) / 2.0).round, 0].max
  end

  def escape_xml(value)
    value.to_s
         .gsub("&", "&amp;")
         .gsub("<", "&lt;")
         .gsub(">", "&gt;")
         .gsub('"', "&quot;")
         .gsub("'", "&apos;")
  end

  def svg_color(value)
    value.to_s.include?("@") ? value.to_s.split("@", 2).first : value.to_s
  end

  def ffmpeg_filter_available?(name)
    return true if @dry_run

    available_ffmpeg_filters.include?(name)
  end

  def ffmpeg_decoder_available?(name)
    return true if @dry_run

    available_ffmpeg_decoders.include?(name)
  end

  def available_ffmpeg_filters
    @available_ffmpeg_filters ||= ffmpeg_list("filters")
  end

  def available_ffmpeg_decoders
    @available_ffmpeg_decoders ||= ffmpeg_list("decoders")
  end

  def ffmpeg_list(kind)
    stdout, stderr, status = Open3.capture3("ffmpeg", "-hide_banner", "-#{kind}")
    raise "Could not inspect FFmpeg #{kind}: #{stderr.empty? ? stdout : stderr}" unless status.success?

    stdout.lines.map { |line| line.split[1] }.compact
  end

  def warn_missing_drawtext
    return if @warned_missing_drawtext

    warn "FFmpeg drawtext filter is unavailable; using generated subtitle image overlays."
    @warned_missing_drawtext = true
  end

  def warn_missing_colorkey
    return if @warned_missing_colorkey

    warn "FFmpeg colorkey filter is unavailable; SVG thumbnail backgrounds may remain visible."
    @warned_missing_colorkey = true
  end

  def resolve_optional_file(path)
    return nil if path.nil? || path.to_s.empty?

    absolute_path(path)
  end

  def resolve_output(path)
    absolute_path(path)
  end

  def absolute_path(path)
    path = path.to_s
    File.absolute_path(path.start_with?("/") ? path : File.join(@base_dir, path))
  end

  def escape_drawtext(text)
    text.to_s
        .gsub("\\", "\\\\")
        .gsub(":", "\\:")
        .gsub("'", "\\\\'")
        .gsub("%", "\\%")
        .gsub("\n", "\\n")
  end

  def escape_filter_path(path)
    path.to_s.gsub("\\", "\\\\").gsub(":", "\\:").gsub("'", "\\\\'")
  end

  def integer(value)
    Integer(value)
  rescue ArgumentError, TypeError
    raise ArgumentError, "Expected integer, got #{value.inspect}"
  end

  def number(value)
    Float(value)
  rescue ArgumentError, TypeError
    raise ArgumentError, "Expected number, got #{value.inspect}"
  end

  def truthy?(value)
    case value
    when true then true
    when false, nil then false
    else %w[1 true yes on].include?(value.to_s.strip.downcase)
    end
  end

  def deep_merge(base, override)
    base.merge(override) do |_key, old_value, new_value|
      old_value.is_a?(Hash) && new_value.is_a?(Hash) ? deep_merge(old_value, new_value) : new_value
    end
  end
end

options = {
  dry_run: false,
  render: true,
  explicit: {},
  icon_style: IconSearch::DEFAULT_STYLE,
  icon_source: IconSearch::DEFAULT_SOURCE,
  icon_license_type: IconSearch::DEFAULT_LICENSE_TYPE,
  icon_size: IconSearch::DEFAULT_SIZE,
  icon_limit: IconSearch::DEFAULT_LIMIT,
  kokoro_voice: KokoroTTS::DEFAULT_VOICE,
  kokoro_speed: KokoroTTS::DEFAULT_SPEED,
  kokoro_lang_code: KokoroTTS::DEFAULT_LANG_CODE,
  whisper_model: ENV.fetch("WHISPER_MODEL", OpenAIWhisper::DEFAULT_MODEL),
  whisper_output_format: OpenAIWhisper::DEFAULT_OUTPUT_FORMAT,
  whisper_task: OpenAIWhisper::DEFAULT_TASK,
  whisper_word_timestamps: OpenAIWhisper::DEFAULT_WORD_TIMESTAMPS
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ffmpeg_video_builder [options] path/to/script.txt|path/to/project.json"
  opts.on("--dry-run", "Print the FFmpeg command without executing it") do
    options[:dry_run] = true
  end
  opts.on("--prepare-only", "--no-render", "--until-icons", "Generate project assets and config without rendering video") do
    options[:render] = false
  end
  opts.on("--icon-search KEYWORD", "Search Iconify icons by keyword and print JSON results") do |keyword|
    options[:icon_search_keyword] = keyword
  end
  opts.on("--icon-style STYLE", "Icon style preference, default: #{IconSearch::DEFAULT_STYLE}") do |style|
    options[:icon_style] = style
    options[:explicit][:icon_style] = true
  end
  opts.on("--icon-source SOURCE", "Iconify source prefix, default: #{IconSearch::DEFAULT_SOURCE}") do |source|
    options[:icon_source] = source
    options[:explicit][:icon_source] = true
  end
  opts.on("--icon-license-type TYPE", "Icon license type, default: #{IconSearch::DEFAULT_LICENSE_TYPE}") do |license_type|
    options[:icon_license_type] = license_type
    options[:explicit][:icon_license_type] = true
  end
  opts.on("--icon-size PIXELS", Integer, "Icon asset size in pixels, default: #{IconSearch::DEFAULT_SIZE}") do |size|
    options[:icon_size] = size
    options[:explicit][:icon_size] = true
  end
  opts.on("--icon-limit COUNT", Integer, "Maximum icon search results, default: #{IconSearch::DEFAULT_LIMIT}") do |limit|
    options[:icon_limit] = limit
  end
  opts.on("--rebuild-project PROJECT_DIR", "Rebuild an existing generated project from edited icon_plan.json without icon search") do |project_dir|
    options[:rebuild_project_dir] = project_dir
  end
  opts.on("--rebuild-workspace DIR", "Rebuild every project listed in a workspace bulk_manifest.json") do |dir|
    options[:rebuild_workspace_dir] = dir
  end
  opts.on("--bulk-workspace DIR", "Generate multiple videos from one workspace directory") do |dir|
    options[:bulk_workspace_dir] = dir
  end
  opts.on("--bulk-scripts FILE", "Bulk script file, default: scripts.txt in the workspace") do |file|
    options[:bulk_scripts_file] = file
  end
  opts.on("--background-color COLOR", "Generated video background color, default: #FFC067") do |color|
    options[:background_color] = color
    options[:explicit][:background_color] = true
  end
  opts.on("--background-image SOURCE", "Generated video image background path or URL") do |source|
    options[:background_image] = source
    options[:explicit][:background_image] = true
  end
  opts.on("--background-video SOURCE", "Generated video background path or URL") do |source|
    options[:background_video] = source
    options[:explicit][:background_video] = true
  end
  opts.on("--kokoro-speak TEXT", "Generate narration audio with local Kokoro text") do |text|
    options[:kokoro_text] = text
  end
  opts.on("--kokoro-script FILE", "Generate narration audio with local Kokoro from a text file") do |file|
    options[:kokoro_text_file] = file
  end
  opts.on("--kokoro-voice VOICE", "Kokoro voice, default: #{KokoroTTS::DEFAULT_VOICE}") do |voice|
    options[:kokoro_voice] = voice
    options[:explicit][:kokoro_voice] = true
  end
  opts.on("--kokoro-speed SPEED", Float, "Kokoro speed, default: #{KokoroTTS::DEFAULT_SPEED}") do |speed|
    options[:kokoro_speed] = speed
    options[:explicit][:kokoro_speed] = true
  end
  opts.on("--kokoro-lang-code CODE", "Kokoro language code, default: #{KokoroTTS::DEFAULT_LANG_CODE}") do |lang_code|
    options[:kokoro_lang_code] = lang_code
    options[:explicit][:kokoro_lang_code] = true
  end
  opts.on("--whisper-transcribe AUDIO_FILE", "Transcribe an audio file with OpenAI Whisper") do |file|
    options[:whisper_audio_file] = file
  end
  opts.on("--whisper-model MODEL", "Local Whisper model, default: #{options.fetch(:whisper_model)}") do |model|
    options[:whisper_model] = model
    options[:explicit][:whisper_model] = true
  end
  opts.on("--whisper-output-format FORMAT", "Whisper output format, default: #{OpenAIWhisper::DEFAULT_OUTPUT_FORMAT}") do |format|
    options[:whisper_output_format] = format
  end
  opts.on("--whisper-task TASK", "Whisper task, default: #{OpenAIWhisper::DEFAULT_TASK}") do |task|
    options[:whisper_task] = task
    options[:explicit][:whisper_task] = true
  end
  opts.on("--[no-]whisper-word-timestamps", "Enable word timestamps for sentence timing, default: enabled") do |word_timestamps|
    options[:whisper_word_timestamps] = word_timestamps
    options[:explicit][:whisper_word_timestamps] = true
  end
  opts.on("--whisper-language LANGUAGE", "Optional input language hint, such as en or id") do |language|
    options[:whisper_language] = language
    options[:explicit][:whisper_language] = true
  end
  opts.on("--whisper-prompt PROMPT", "Optional prompt to guide transcription style or vocabulary") do |prompt|
    options[:whisper_prompt] = prompt
    options[:explicit][:whisper_prompt] = true
  end
  opts.on("-h", "--help", "Show help") do
    puts opts
    exit 0
  end
end

parser.parse!

def url?(value)
  uri = URI.parse(value.to_s)
  uri.is_a?(URI::HTTP) && !uri.host.to_s.empty?
rescue URI::InvalidURIError
  false
end

def media_background(type, source)
  if url?(source)
    { "type" => type, "url" => source }
  else
    { "type" => type, "path" => File.expand_path(source.to_s) }
  end
end

def cli_background(options)
  selected = %i[background_color background_image background_video].select { |key| options[key] }
  raise ArgumentError, "Use only one background option: --background-color, --background-image, or --background-video." if selected.length > 1

  if options[:background_color]
    { "type" => "color", "color" => options.fetch(:background_color) }
  elsif options[:background_image]
    media_background("image", options.fetch(:background_image))
  elsif options[:background_video]
    media_background("video", options.fetch(:background_video))
  end
end

def load_workspace_config(workspace_dir)
  config_file = File.join(File.expand_path(workspace_dir.to_s), "config.json")
  return {} unless File.file?(config_file)

  JSON.parse(File.read(config_file))
rescue JSON::ParserError => e
  raise ArgumentError, "Invalid workspace config JSON: #{config_file}: #{e.message}"
end

def normalize_background_config(background, base_dir)
  return nil unless background.is_a?(Hash)

  config = background.transform_keys(&:to_s)
  type = config.fetch("type", "color")
  return { "type" => "color", "color" => config.fetch("color", "#FFC067") } if type == "color"

  source = config["url"] || config["path"] || config["file"]
  raise ArgumentError, "Workspace background #{type.inspect} requires url, path, or file" if source.to_s.empty?

  if url?(source)
    { "type" => type, "url" => source }
  else
    path = File.expand_path(source.to_s, base_dir || Dir.pwd)
    key = config.key?("file") && !config.key?("path") ? "file" : "path"
    { "type" => type, key => path }
  end
end

def workspace_pipeline_options(config, base_dir)
  config = config.transform_keys(&:to_s)
  payload = {}

  if (video = config["video"]).is_a?(Hash)
    video = video.transform_keys(&:to_s)
    payload[:width] = video["width"] if video.key?("width")
    payload[:height] = video["height"] if video.key?("height")
    payload[:fps] = video["fps"] if video.key?("fps")
  end

  if (background = normalize_background_config(config["background"], base_dir))
    payload[:background] = background
  end

  if (icon = config["icon"]).is_a?(Hash)
    icon = icon.transform_keys(&:to_s)
    payload[:icon_style] = icon["style"] if icon.key?("style")
    payload[:icon_source] = icon["source_url"] if icon.key?("source_url")
    payload[:icon_source] = icon["source"] if icon.key?("source")
    payload[:icon_license_type] = icon["license_type"] if icon.key?("license_type")
    payload[:icon_size] = icon["size"] if icon.key?("size")
    payload[:icon_candidate_limit] = icon["candidate_limit"] if icon.key?("candidate_limit")
  end

  if (kokoro = config["kokoro"]).is_a?(Hash)
    kokoro = kokoro.transform_keys(&:to_s)
    payload[:kokoro_voice] = kokoro["voice"] if kokoro.key?("voice")
    payload[:kokoro_speed] = kokoro["speed"] if kokoro.key?("speed")
    payload[:kokoro_lang_code] = kokoro["lang_code"] if kokoro.key?("lang_code")
  end

  if (whisper = config["whisper"]).is_a?(Hash)
    whisper = whisper.transform_keys(&:to_s)
    payload[:whisper_model] = whisper["model"] if whisper.key?("model")
    payload[:whisper_task] = whisper["task"] if whisper.key?("task")
    payload[:whisper_word_timestamps] = whisper["word_timestamps"] if whisper.key?("word_timestamps")
    payload[:whisper_language] = whisper["language"] if whisper.key?("language")
    payload[:whisper_prompt] = whisper["prompt"] if whisper.key?("prompt")
  end

  if (pipeline = config["pipeline"]).is_a?(Hash)
    pipeline = pipeline.transform_keys(&:to_s)
    payload[:pipeline_waveform] = pipeline["waveform"] if pipeline.key?("waveform")
    payload[:pipeline_icon_width] = pipeline["icon_width"] if pipeline.key?("icon_width")
  end

  payload
end

def explicit_pipeline_options(options)
  explicit = options.fetch(:explicit)
  mapping = {
    icon_style: :icon_style,
    icon_source: :icon_source,
    icon_license_type: :icon_license_type,
    icon_size: :icon_size,
    kokoro_voice: :kokoro_voice,
    kokoro_speed: :kokoro_speed,
    kokoro_lang_code: :kokoro_lang_code,
    whisper_model: :whisper_model,
    whisper_task: :whisper_task,
    whisper_word_timestamps: :whisper_word_timestamps,
    whisper_language: :whisper_language,
    whisper_prompt: :whisper_prompt
  }

  mapping.each_with_object({}) do |(option_key, pipeline_key), payload|
    payload[pipeline_key] = options[option_key] if explicit[option_key]
  end
end

def pipeline_options(options, workspace_config: {}, config_base_dir: nil)
  background = cli_background(options)
  payload = {
    icon_style: options.fetch(:icon_style),
    icon_source: options.fetch(:icon_source),
    icon_license_type: options.fetch(:icon_license_type),
    icon_size: options.fetch(:icon_size),
    kokoro_voice: options.fetch(:kokoro_voice),
    kokoro_speed: options.fetch(:kokoro_speed),
    kokoro_lang_code: options.fetch(:kokoro_lang_code),
    whisper_model: options.fetch(:whisper_model),
    whisper_task: options.fetch(:whisper_task),
    whisper_word_timestamps: options.fetch(:whisper_word_timestamps),
    whisper_language: options[:whisper_language],
    whisper_prompt: options[:whisper_prompt]
  }
  payload.merge!(workspace_pipeline_options(workspace_config, config_base_dir)) unless workspace_config.empty?
  payload.merge!(explicit_pipeline_options(options))
  payload[:background] = background if background
  payload
end

def rebuild_options(options, workspace_config: {}, config_base_dir: nil)
  payload = pipeline_options(options, workspace_config: workspace_config, config_base_dir: config_base_dir)
  payload.select do |key, _value|
    %i[
      width height fps background
      icon_license_type icon_size
      pipeline_waveform pipeline_icon_width
    ].include?(key)
  end
end

def bulk_manifest_project_dirs(workspace_dir)
  workspace_dir = File.expand_path(workspace_dir.to_s)
  manifest_file = File.join(workspace_dir, "bulk_manifest.json")
  raise ArgumentError, "Bulk manifest not found: #{manifest_file}. Run --bulk-workspace first." unless File.file?(manifest_file)

  manifest = JSON.parse(File.read(manifest_file))
  videos = manifest.fetch("videos")
  project_dirs = videos.map { |video| video.fetch("project_dir") }.map { |dir| File.expand_path(dir.to_s) }.uniq
  raise ArgumentError, "No project directories found in #{manifest_file}" if project_dirs.empty?

  project_dirs
rescue JSON::ParserError => e
  raise ArgumentError, "Invalid bulk manifest JSON: #{manifest_file}: #{e.message}"
end

def render_pipeline_if_requested(pipeline, options)
  return unless options.fetch(:render)

  FFmpegVideoBuilder.call(config_path: pipeline.config_file, dry_run: options[:dry_run])
  move_rendered_output!(pipeline) unless options[:dry_run]
end

def move_rendered_output!(pipeline, outputs_dir: "outputs")
  source = pipeline.output_file.to_s
  return unless File.file?(source)

  destination_dir = File.expand_path(outputs_dir)
  FileUtils.mkdir_p(destination_dir)
  destination = File.join(destination_dir, File.basename(source))
  FileUtils.rm_f(destination)
  FileUtils.mv(source, destination)
  pipeline.output_file = destination
  update_project_output_metadata!(pipeline, destination)
  destination
end

def update_project_output_metadata!(pipeline, output_file)
  metadata_file = File.join(pipeline.project_dir, "pipeline_metadata.json")
  return unless File.file?(metadata_file)

  metadata = JSON.parse(File.read(metadata_file))
  metadata["output_file"] = output_file
  File.write(metadata_file, "#{JSON.pretty_generate(metadata)}\n")
rescue JSON::ParserError
  warn "Warning: could not update invalid metadata JSON: #{metadata_file}"
end

def update_bulk_manifest_outputs!(workspace_dir, pipelines)
  manifest_file = File.join(File.expand_path(workspace_dir.to_s), "bulk_manifest.json")
  return unless File.file?(manifest_file)

  manifest = JSON.parse(File.read(manifest_file))
  outputs_by_project = pipelines.each_with_object({}) do |pipeline, mapping|
    mapping[File.expand_path(pipeline.project_dir)] = pipeline.output_file
  end
  manifest["videos"] = manifest.fetch("videos", []).map do |video|
    project_dir = File.expand_path(video.fetch("project_dir"))
    outputs_by_project[project_dir] ? video.merge("output_file" => outputs_by_project.fetch(project_dir)) : video
  end
  File.write(manifest_file, "#{JSON.pretty_generate(manifest)}\n")
rescue JSON::ParserError
  warn "Warning: could not update invalid bulk manifest JSON: #{manifest_file}"
end

def config_output_file(config_path)
  config = JSON.parse(File.read(config_path))
  output = config.fetch("output", FFmpegVideoBuilder::DEFAULTS.fetch("output"))
  File.expand_path(output.to_s, File.dirname(File.expand_path(config_path)))
end

def render_config_and_move_output(config_path, options)
  FFmpegVideoBuilder.call(config_path: config_path, dry_run: options[:dry_run])
  return if options[:dry_run]

  source = config_output_file(config_path)
  return unless File.file?(source)

  destination_dir = File.expand_path("outputs")
  FileUtils.mkdir_p(destination_dir)
  destination = File.join(destination_dir, File.basename(source))
  FileUtils.rm_f(destination)
  FileUtils.mv(source, destination)
end

begin
  if options[:icon_search_keyword]
    batch = IconSearch.search_and_download(
      keyword: options.fetch(:icon_search_keyword),
      style: options.fetch(:icon_style),
      source: options.fetch(:icon_source),
      license_type: options.fetch(:icon_license_type),
      size: options.fetch(:icon_size),
      limit: options.fetch(:icon_limit)
    )
    puts JSON.pretty_generate(batch.to_h)
    exit 0
  end

  if options[:kokoro_text] || options[:kokoro_text_file]
    narration = KokoroTTS.speak(
      text: options[:kokoro_text],
      text_file: options[:kokoro_text_file],
      voice: options.fetch(:kokoro_voice),
      speed: options.fetch(:kokoro_speed),
      lang_code: options.fetch(:kokoro_lang_code)
    )
    puts JSON.pretty_generate(narration.to_h)
    exit 0
  end

  if options[:whisper_audio_file]
    transcription = OpenAIWhisper.transcribe(
      file: options.fetch(:whisper_audio_file),
      model: options.fetch(:whisper_model),
      output_format: options.fetch(:whisper_output_format),
      task: options.fetch(:whisper_task),
      word_timestamps: options.fetch(:whisper_word_timestamps),
      language: options[:whisper_language],
      prompt: options[:whisper_prompt]
    )
    puts JSON.pretty_generate(transcription.to_h)
    exit 0
  end

  if options[:rebuild_project_dir]
    pipeline = ScriptVideoPipeline.rebuild(
      project_dir: options.fetch(:rebuild_project_dir),
      options: rebuild_options(options)
    )
    puts JSON.pretty_generate(pipeline.to_h)
    render_pipeline_if_requested(pipeline, options)
    exit 0
  end

  if options[:rebuild_workspace_dir]
    workspace_dir = options.fetch(:rebuild_workspace_dir)
    workspace_config = load_workspace_config(workspace_dir)
    pipelines = bulk_manifest_project_dirs(workspace_dir).map do |project_dir|
      ScriptVideoPipeline.rebuild(
        project_dir: project_dir,
        options: rebuild_options(options, workspace_config: workspace_config, config_base_dir: workspace_dir)
      )
    end
    puts JSON.pretty_generate(pipelines.map(&:to_h))
    pipelines.each do |pipeline|
      render_pipeline_if_requested(pipeline, options)
    end
    update_bulk_manifest_outputs!(workspace_dir, pipelines) if options.fetch(:render) && !options[:dry_run]
    exit 0
  end

  if options[:bulk_workspace_dir]
    workspace_dir = options.fetch(:bulk_workspace_dir)
    workspace_config = load_workspace_config(workspace_dir)
    pipelines = ScriptVideoPipeline.prepare_bulk(
      workspace_dir: workspace_dir,
      scripts_file: options[:bulk_scripts_file],
      options: pipeline_options(options, workspace_config: workspace_config, config_base_dir: workspace_dir)
    )
    puts JSON.pretty_generate(pipelines.map(&:to_h))
    pipelines.each do |pipeline|
      render_pipeline_if_requested(pipeline, options)
    end
    update_bulk_manifest_outputs!(workspace_dir, pipelines) if options.fetch(:render) && !options[:dry_run]
    exit 0
  end

  input_path = ARGV.first

  unless input_path
    warn parser
    exit 1
  end

  if File.extname(input_path).downcase == ".json"
    render_config_and_move_output(input_path, options)
  else
    script_dir = File.dirname(File.expand_path(input_path))
    workspace_config = load_workspace_config(script_dir)
    pipeline = ScriptVideoPipeline.prepare(
      script_file: input_path,
      options: pipeline_options(options, workspace_config: workspace_config, config_base_dir: script_dir)
    )
    puts JSON.pretty_generate(pipeline.to_h)
    render_pipeline_if_requested(pipeline, options)
  end
rescue StandardError => e
  warn "Error: #{e.message}"
  exit 1
end
